<?xml version="1.0" encoding="utf-8"?>
<!-- The PC window, stood on its end: a fixed page title, a scrolling page, and the six sections of the
     sidebar as a bottom bar. 首页 additionally keeps its one action in a bar under the page, where a thumb
     reaches it; the settings pages (字幕 / 翻译 / 页面 / 记录) use the whole height. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pageSub"
            style="@style/RowSub"
            android:layout_marginTop="4dp"
            android:text="把视频、直播里的声音，实时变成中文字幕"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="2dp"
            android:paddingBottom="20dp">

            <!-- ===== 首页: what is spoken → what the captions are in, what translates them, this session ===== -->
            <LinearLayout
                android:id="@+id/pageHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    style="@style/ListCard"
                    android:layout_marginTop="6dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp" />

                            <TextView
                                android:id="@+id/statusTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:textColor="@color/text"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/statusBody"
                            style="@style/RowSub"
                            android:layout_marginTop="4dp"
                            android:paddingStart="16dp" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:max="1000"
                            android:visibility="gone"
                            app:indicatorColor="@color/brand"
                            app:trackColor="@color/pill"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 本次会话: everything said since the session started, as on the PC -->
                <TextView
                    android:id="@+id/sessionTitle"
                    style="@style/SectionTitle"
                    android:text="本次会话" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/sessionCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:textColor="@color/label"
                                android:textSize="12.5sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sessionExport"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="40dp"
                                android:text="导出…"
                                android:textSize="13sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/sessionClear"
                                style="?attr/borderlessButtonStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="0dp"
                                android:minHeight="40dp"
                                android:text="清空"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/sessionSearch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="@drawable/field_bg"
                            android:hint="搜索这次会话的字幕"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLines="1"
                            android:minHeight="44dp"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp"
                            android:textColor="@color/text"
                            android:textColorHint="@color/muted"
                            android:textSize="14sp" />

                        <!-- the transcript goes in here: built in code, it scrolls on its own once it outgrows
                             the card, so the whole session stays reachable instead of the newest lines pushing
                             the older ones out -->
                        <FrameLayout
                            android:id="@+id/sessionScrollBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/sessionEmpty"
                            style="@style/RowSub"
                            android:paddingVertical="14dp"
                            android:text="开始字幕后，这里会一条条列出这次说过的句子。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/RowSub"
                    android:layout_marginTop="12dp"
                    android:paddingHorizontal="8dp"
                    android:text="声音只在手机上识别，不会上传；翻译时只把识别出的文字发给你填的 LLM API。" />

                <!-- permissions, only while a required one is missing -->
                <LinearLayout
                    android:id="@+id/permCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="开始前，需要你允许下面两件事" />

                    <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                        <LinearLayout
                            android:id="@+id/permList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 字幕 ===== -->
            <LinearLayout
                android:id="@+id/pageCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="外观" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp">

                        <FrameLayout
                            android:id="@+id/previewStage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/preview_stage"
                            android:minHeight="120dp">

                            <FrameLayout
                                android:id="@+id/previewHolder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="bottom|center_horizontal"
                                android:layout_marginTop="12dp"
                                android:layout_marginBottom="12dp" />
                        </FrameLayout>

                        <TextView
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp"
                            android:text="字幕配色" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <HorizontalScrollView
                                android:id="@+id/paletteScroll"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:scrollbars="none">

                                <LinearLayout
                                    android:id="@+id/paletteRow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal" />
                            </HorizontalScrollView>

                            <View
                                android:id="@+id/paletteFade"
                                android:layout_width="28dp"
                                android:layout_height="match_parent"
                                android:layout_gravity="end"
                                android:background="@drawable/palette_fade"
                                android:importantForAccessibility="no" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/labelSize"
                            style="@style/SliderLabel"
                            android:layout_marginTop="14dp" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderSize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="文字大小"
                            android:stepSize="1"
                            android:valueFrom="5"
                            android:valueTo="36" />

                        <TextView
                            android:id="@+id/labelAlpha"
                            style="@style/SliderLabel" />

                        <com.google.android.material.slider.Slider
                            android:id="@+id/sliderAlpha"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:contentDescription="背景浓淡"
                            android:stepSize="5"
                            android:valueFrom="0"
                            android:valueTo="100" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    style="@style/SectionTitle"
                    android:text="显示" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchJa"
                            style="@style/RowSwitch"
                            android:text="同时显示原文" />

                        <View style="@style/RowDivider" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchStats"
                            style="@style/RowSwitch"
                            android:text="显示识别和翻译用时" />

                        <View style="@style/RowDivider" />

                        <!-- 字幕框大小和保留几句: a page of its own on the old build, inline here like the PC -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="14dp"
                            android:paddingBottom="8dp">

                            <TextView
                                android:id="@+id/labelWidth"
                                style="@style/SliderLabel"
                                android:layout_marginTop="14dp" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderWidth"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="字幕宽度"
                                android:stepSize="5"
                                android:valueFrom="40"
                                android:valueTo="100" />

                            <TextView
                                android:id="@+id/labelHeight"
                                style="@style/SliderLabel" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderHeight"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="字幕高度"
                                android:stepSize="5"
                                android:valueFrom="0"
                                android:valueTo="40" />

                            <TextView
                                android:id="@+id/labelKeepSentences"
                                style="@style/SliderLabel" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderKeepSentences"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="屏幕上至少留几句"
                                android:stepSize="1"
                                android:valueFrom="1"
                                android:valueTo="6" />

                            <TextView
                                android:id="@+id/labelKeepChars"
                                style="@style/SliderLabel" />

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderKeepChars"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:contentDescription="字数上限"
                                android:stepSize="10"
                                android:valueFrom="0"
                                android:valueTo="300" />

                            <TextView
                                android:id="@+id/keepHint"
                                style="@style/RowSub"
                                android:layout_marginTop="2dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resetStyle"
                    style="?attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="4dp"
                    android:minHeight="48dp"
                    android:text="恢复默认" />
            </LinearLayout>

            <!-- ===== 翻译: 语言 first, then the groups and lists built in code ===== -->
            <LinearLayout
                android:id="@+id/pageTranslate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="语言" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:id="@+id/langBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />

                        <TextView
                            android:id="@+id/langHint"
                            style="@style/RowSub"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/translateList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- ===== 页面: colour, notifications and 关于 (the PC keeps 关于 in the sidebar; here it is the
                 third group of this page, so the bar stays at five) ===== -->
            <LinearLayout
                android:id="@+id/pagePage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="页面颜色" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/themeBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:id="@+id/notifSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="通知" />

                    <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                        <LinearLayout
                            android:id="@+id/notifList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <TextView
                    style="@style/SectionTitle"
                    android:text="关于" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/aboutVersion"
                            style="@style/RowName"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:minHeight="48dp"
                            android:paddingHorizontal="14dp" />

                        <View style="@style/RowDivider" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/autoUpdate"
                            style="@style/RowSwitch"
                            android:text="自动检查更新" />

                        <View style="@style/RowDivider" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:baselineAligned="false"
                            android:padding="10dp">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/checkUpdate"
                                style="@style/Widget.JpSub.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:text="检查更新" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/openRepo"
                                style="@style/Widget.JpSub.ActionButton"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="GitHub 项目主页" />
                        </LinearLayout>

                        <TextView
                            style="@style/RowSub"
                            android:paddingHorizontal="14dp"
                            android:text="https://github.com/J1nxi-youmi/simul-subtitle-diy"
                            android:textIsSelectable="true" />

                        <TextView
                            style="@style/RowSub"
                            android:paddingHorizontal="14dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="14dp"
                            android:text="个人 diy 版：语音识别换成 SenseVoice（中/英/日/韩/粤，sherpa-onnx 本地运行，模型已装在 App 里），翻译接自己的 LLM API，译文检查用自己的模型。Silero VAD 用于断句。感谢这些开源项目。" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ===== 记录 ===== -->
            <LinearLayout
                android:id="@+id/pageRecords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/SectionTitle"
                    android:text="使用记录" />

                <com.google.android.material.card.MaterialCardView style="@style/ListCard">

                    <LinearLayout
                        android:id="@+id/logList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- the one action of 首页, under the page and above the bar -->
    <LinearLayout
        android:id="@+id/actionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:textColor="@color/on_brand"
                android:textSize="16sp"
                android:textStyle="bold"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/on_brand" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/secondary"
                style="?attr/borderlessButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:visibility="gone" />

            <!-- what the button will use: engine, model, sentence mode — the PC puts these beside its button -->
            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipEngine"
                    style="@style/Chip" />

                <TextView
                    android:id="@+id/chipTranslate"
                    style="@style/Chip"
                    android:layout_marginStart="8dp" />

                <TextView
                    android:id="@+id/chipMode"
                    style="@style/Chip"
                    android:layout_marginStart="8dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- the PC sidebar, laid on its side -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line2" />

        <LinearLayout
            android:id="@+id/navBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingTop="4dp"
            android:paddingEnd="6dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/navHome"
                style="@style/NavItem"
                android:text="首页" />

            <TextView
                android:id="@+id/navCaption"
                style="@style/NavItem"
                android:text="字幕" />

            <TextView
                android:id="@+id/navTranslate"
                style="@style/NavItem"
                android:text="翻译" />

            <TextView
                android:id="@+id/navPage"
                style="@style/NavItem"
                android:text="页面" />

            <TextView
                android:id="@+id/navRecords"
                style="@style/NavItem"
                android:text="记录" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
