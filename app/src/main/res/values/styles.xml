<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- magpie's .label: small grey caps-weight title above a list. CJK has no case, so the
         tracking stays small; the colour is @color/label (4.6:1 on bg, muted is only 3.3:1) -->
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.03</item>
    </style>
    <!-- magpie's .list: white card, 12dp corners, a hairline edge instead of a shadow -->
    <style name="ListCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <!-- a row's name (magpie's .row .name) -->
    <style name="RowName">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- a row's line under the name (magpie's .row .sub). text2, not muted: these lines carry the status, privacy
         and cost explanations, and muted is under 4.5:1 on white -->
    <style name="RowSub">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <!-- a slider's name and value, one line above the slider -->
    <style name="SliderLabel" parent="RowName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
    <!-- a list row with a switch on the right: full width, finger-sized -->
    <style name="RowSwitch" parent="Widget.JpSub.Switch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- magpie's toggle: an ink track with a card-coloured thumb when on, a pale line track when off -->
    <style name="Widget.JpSub.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="trackTint">@color/switch_track</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackDecorationTint">@color/switch_deco</item>
    </style>
    <!-- magpie's .eslide: ink fill on a line-coloured rail, a small round white knob, no value bubble. Material 1.12's
         M3 slider draws a tall 4dp-wide bar with a gap and stop dots; the Legacy style keeps the round thumb. -->
    <style name="Widget.JpSub.Slider" parent="Widget.Material3.Slider.Legacy">
        <item name="trackColorActive">@color/text</item>
        <item name="trackColorInactive">@color/line</item>
        <item name="thumbColor">@color/slider_thumb</item>
        <item name="haloColor">@color/slider_halo</item>
        <item name="tickVisible">false</item>
        <item name="labelBehavior">gone</item>
        <item name="trackHeight">4dp</item>
        <item name="thumbRadius">9dp</item>
        <item name="thumbElevation">2dp</item>
        <item name="thumbStrokeColor">@color/line</item>
        <item name="thumbStrokeWidth">0.5dp</item>
        <item name="haloRadius">16dp</item>
    </style>
    <!-- magpie's .text: a quiet text button -->
    <style name="Widget.JpSub.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">14sp</item>
        <item name="rippleColor">@color/line</item>
        <item name="shapeAppearance">@style/Shape.JpSub.8</item>
    </style>
    <!-- magpie's .text.primary: the indigo button, 10dp corners -->
    <style name="Widget.JpSub.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Shape.JpSub.10</item>
        <item name="android:textSize">15sp</item>
    </style>
    <!-- magpie's .text.action: a white button with a hairline. Side by side they share one row, so they get the same
         fixed inset and height (the row stretches both to the taller one, see activity_main tabAbout). -->
    <style name="Widget.JpSub.ActionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="strokeColor">@color/line</item>
        <item name="backgroundTint">@color/card</item>
        <item name="rippleColor">@color/line</item>
        <item name="shapeAppearance">@style/Shape.JpSub.8</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>
    <!-- magpie's .seg: a grey track, the chosen option a card-coloured thumb, the others plain grey text, no outlines.
         One button of a MaterialButtonToggleGroup; the group paints the track (seg_track.xml). -->
    <style name="Widget.JpSub.Segment" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/seg_bg</item>
        <item name="android:textColor">@color/seg_fg</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">@color/line</item>
        <item name="shapeAppearance">@style/Shape.JpSub.8</item>
        <item name="android:insetTop">3dp</item>
        <item name="android:insetBottom">3dp</item>
        <item name="android:textSize">14sp</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="Shape.JpSub.8" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Shape.JpSub.10" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>
    <!-- the hairline between two rows of a list (magpie's .row + .row), inset from the start -->
    <style name="RowDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:background">@color/line2</item>
    </style>
    <!-- a status chip under the start button: a dot and a short line, as on the PC -->
    <style name="Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_bg</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text2</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
    <!-- one tab of the bottom bar: the PC sidebar's item, laid on its side -->
    <style name="NavItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">2dp</item>
        <item name="android:layout_marginVertical">3dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nav_text</item>
        <item name="android:background">@drawable/nav_item_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
